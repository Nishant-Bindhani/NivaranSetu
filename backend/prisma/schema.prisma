generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Module 2 — Database Design

enum Role {
  CITIZEN
  OFFICER
  MANAGER
  ADMIN
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String?
  name            String
  avatarUrl       String?
  role            Role     @default(CITIZEN)
  phone           String?
  googleId        String?  @unique
  isEmailVerified Boolean  @default(false)
  isActive        Boolean  @default(true)

  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id])

  deptId     String?
  department Department? @relation(fields: [deptId], references: [id])

  refreshTokens      RefreshToken[]
  loginHistory       LoginHistory[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  tickets            Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([deptId])
  @@map("users")
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model VerificationToken {
  id        String                 @id @default(uuid())
  tokenHash String                 @unique
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VerificationTokenType
  expiresAt DateTime
  createdAt DateTime               @default(now())

  @@index([userId, type])
  @@map("verification_tokens")
}

model RefreshToken {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId   String
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum LoginStatus {
  SUCCESS
  FAILED
}

model LoginHistory {
  id             String      @id @default(uuid())
  userId         String?
  user           User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAttempted String
  ipAddress      String?
  userAgent      String?
  status         LoginStatus
  createdAt      DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([emailAttempted, createdAt])
  @@map("login_history")
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String
  deviceName String?
  lastSeen   DateTime @default(now())
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("sessions")
}

model Permission {
  id     String @id @default(uuid())
  role   Role
  action String

  @@unique([role, action])
  @@map("permissions")
}

model Organization {
  id       String @id @default(uuid())
  name     String
  slug     String @unique
  settings Json   @default("{}")

  departments Department[]
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

model Department {
  id          String  @id @default(uuid())
  name        String
  description String?

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  parentDeptId   String?
  parentDept     Department?  @relation("DepartmentHierarchy", fields: [parentDeptId], references: [id])
  subDepartments Department[] @relation("DepartmentHierarchy")

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@map("departments")
}

model Category {
  id          String  @id @default(uuid())
  name        String
  description String?
  isActive    Boolean @default(true)

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
  REOPENED
}

model Ticket {
  id          String       @id @default(uuid())
  title       String
  description String
  status      TicketStatus @default(OPEN)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Nullable, unused by any application logic in this first slice — added
  // now because the RLS policy (built alongside this module) needs a real
  // column to reference. A citizen's ticket leaves both null; officer
  // assignment (a later slice) is what actually populates deptId.
  deptId String?
  orgId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([categoryId])
  @@index([deptId])
  @@index([orgId])
  @@map("tickets")
}